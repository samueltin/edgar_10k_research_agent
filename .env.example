# Choose one provider (see src/edgar_research_agent/agent/llm_provider.py)
LLM_PROVIDER=ollama   # or: anthropic/azure_openai/ollama

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
