# SEC EDGAR requires a real identifying User-Agent (name + email)
EDGAR_IDENTITY="Your Name <you@example.com>"

AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

GROUNDEDNESS_BACKEND=custom_llm   # or: azure_content_safety/custom_llm

OLLAMA_BASE_URL=
OLLAMA_MODEL=